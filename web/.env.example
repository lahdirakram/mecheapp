# Mèche Studio (web) — copier vers web/.env.local (ignoré par git via la règle .env.*).
#
# Vite inline tout ce qui commence par VITE_ DANS LE BUNDLE, donc lisible par n'importe quel
# visiteur. Ne mettre ici QUE des valeurs publiables. Jamais de service_role.
#
# Par défaut : STAGING (vefxfjcdvstjwieasrbq). Tout le tunnel jusqu'à la révélation est testable
# là-bas, puisque le teaser ne dépend que du crédit de bienvenue et pas d'un paiement.

VITE_SUPABASE_URL=https://vefxfjcdvstjwieasrbq.supabase.co

# Supabase → Project Settings → API → anon / public
VITE_SUPABASE_ANON_KEY=

# --- Prod (hqhnvjjbohzktoapsytj) ---
# ATTENTION : le webhook Paddle écrira dans la prod, comme l'IAP. Il n'y a pas de paiement staging.
# VITE_SUPABASE_URL=https://hqhnvjjbohzktoapsytj.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Paddle (optionnel) — sans ces valeurs, le paywall appelle unlock directement,
# ce qui ne marche que si le compte a deja un credit. Cest le mode de test staging.
# Paddle > Developer tools > Authentication > client-side token. Publiable.
VITE_PADDLE_CLIENT_TOKEN=
# sandbox | production
VITE_PADDLE_ENV=sandbox
